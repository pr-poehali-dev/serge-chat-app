[Unit]
Description=Trindelka messenger API
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/trindelka/app/deploy
EnvironmentFile=/etc/trindelka.env
ExecStart=/var/www/trindelka/venv/bin/gunicorn -w 3 -b 127.0.0.1:8000 --timeout 90 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
