{
  "tests": [
    {
      "name": "Get chats list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Get messages for chat 1",
      "method": "GET",
      "path": "/?action=messages&chat_id=1",
      "expectedStatus": 200
    },
    {
      "name": "Toggle reaction without message_id returns 400",
      "method": "POST",
      "path": "/?action=toggle-reaction",
      "body": {
        "emoji": "😂"
      },
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Create group without session returns 401",
      "method": "POST",
      "path": "/?action=create-group",
      "body": {
        "name": "Тест",
        "member_ids": [
          2
        ]
      },
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "Get topics for chat 3",
      "method": "GET",
      "path": "/?action=topics&chat_id=3",
      "expectedStatus": 200
    },
    {
      "name": "Get presence status for chat 1",
      "method": "GET",
      "path": "/?action=status&chat_id=1",
      "expectedStatus": 200
    },
    {
      "name": "Start chat without user_id returns 400",
      "method": "POST",
      "path": "/?action=start-chat",
      "body": {},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Edit message without session returns 401",
      "method": "POST",
      "path": "/?action=edit-message",
      "body": {
        "message_id": 1,
        "text": "Правка"
      },
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "Remove message without session returns 401",
      "method": "POST",
      "path": "/?action=remove-message",
      "body": {
        "message_id": 1
      },
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "Pin message without session returns 401",
      "method": "POST",
      "path": "/?action=pin-message",
      "body": {
        "chat_id": 1,
        "message_id": 1
      },
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    }
  ]
}