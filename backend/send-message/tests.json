{
  "tests": [
    {
      "name": "Send message",
      "method": "POST",
      "path": "/",
      "body": {
        "chat_id": 1,
        "text": "Тест сообщение"
      },
      "expectedStatus": 200
    },
    {
      "name": "Voice without media returns 400",
      "method": "POST",
      "path": "/",
      "body": {
        "chat_id": 1,
        "kind": "voice"
      },
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Image without media returns 400",
      "method": "POST",
      "path": "/",
      "body": {
        "chat_id": 1,
        "kind": "image"
      },
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Missing text returns 400",
      "method": "POST",
      "path": "/",
      "body": {
        "chat_id": 1
      },
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Forward of missing message returns 404",
      "method": "POST",
      "path": "/",
      "body": {
        "chat_id": 1,
        "forward_message_id": 99999999
      },
      "expectedStatus": 404,
      "bodyMatcher": "partial"
    }
  ]
}