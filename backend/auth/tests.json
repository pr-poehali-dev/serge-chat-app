{
  "tests": [
    {
      "name": "Get current user without session returns 401",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "Login with wrong credentials returns 401",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "email": "nonexistent@example.com", "password": "wrongpass"},
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "Register with short password returns 400",
      "method": "POST",
      "path": "/",
      "body": {"action": "register", "email": "test@example.com", "password": "123"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Forgot password with invalid email returns 400",
      "method": "POST",
      "path": "/",
      "body": {"action": "forgot-password", "email": "not-an-email"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Reset password without token returns 400",
      "method": "POST",
      "path": "/",
      "body": {"action": "reset-password", "password": "newpass123"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    }
  ]
}